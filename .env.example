# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IPTV_ENCRYPTION_KEY: Clé secrète de chiffrement pour AES-256. Elle sera générée automatiquement par défaut si absente.
IPTV_ENCRYPTION_KEY="VOTRE_CLE_DE_CHIFFREMENT_SECRET_DE_32_CHARS"

# FIREBASE_CONFIG: Configuration JSON de votre base de données Firestore Firebase (si déployé hors AI Studio)
# Exemple: {"projectId":"prismatic-hologram-w7c1c","apiKey":"...","authDomain":"...","firestoreDatabaseId":"ai-studio-iptvsecure-557bbb75-14cd-45eb-b63e-ca2bab211260"}
FIREBASE_CONFIG=""

